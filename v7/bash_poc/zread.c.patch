+/* =========================================================================
+ * V7 单进程形态（r10.5 生产化）：在 zread 层透明解密「内嵌于自身 ELF 尾部」
+ * 的加密 V6 骨架。
+ *
+ * 目标：让 bash 自身成为加载器——内嵌解密器 + 加密骨架，单进程自解密自执行，
+ *       没有父子进程边界（即不存在 elfrun 父进程对 bash 子进程的完全访问权）。
+ *
+ * 激活条件：仅当环境变量 V7_SELF 存在时启用；否则本文件与上游完全一致。
+ *
+ * blob v2 布局（追加到 bash ELF 尾部）：
+ *   [RC4 密文 ctlen 字节][HMAC-SHA256 32B][salt 16B][4B LE = ctlen+52]
+ *
+ * 运行期流程（v7_init，首次 zread 触发）：
+ *   1. 读末尾 4B → taillen → 定位 ct / mac / salt；
+ *   2. V7_PASS 必填 → KDF(HMAC-SHA256 链, 20000 轮, salt) → key_enc/key_mac；
+ *   3. HMAC(key_mac, ct) 比对 → 失败 exit(114)（口令错误或产物被篡改）；
+ *   4. RC4 init(key_enc) → v7_read 逐块供给，明文只在 4KB lbuf 驻留。
+ *
+ * 自包含实现：SHA-256 / HMAC / KDF 全在本文件，不依赖任何外部加密库。
+ * 已知边界：对称加密仍为 RC4（无 AES-GCM 前的过渡）；认证由 HMAC-SHA256
+ *   （Encrypt-then-MAC）承担，密文可被检测篡改但不可被 undetectable 翻转。
+ * ========================================================================= */
+#define V7_KDF_ROUNDS 20000
+#define V7_BLOB_OVERHEAD 52          /* mac 32 + salt 16 + len 4 */
+
+static int v7_active = 0;
+static int v7_inited = 0;
+static unsigned char *v7_ct = NULL;   /* 内嵌密文（init 时从 /proc/self/exe 读出） */
+static size_t v7_ct_len = 0;
+static size_t v7_off = 0;
+static unsigned char v7_s[256];
+static int v7_ki = 0, v7_kj = 0;
+
+/* ---------------- RC4（对称，解密即加密） ---------------- */
+static void
+v7_rc4_init (const unsigned char *key, size_t klen)
+{
+  int i, j; unsigned char t;
+  for (i = 0; i < 256; i++) v7_s[i] = (unsigned char) i;
+  for (i = j = 0; i < 256; i++)
+    {
+      j = (j + v7_s[i] + key[i % klen]) & 0xff;
+      t = v7_s[i]; v7_s[i] = v7_s[j]; v7_s[j] = t;
+    }
+  v7_ki = v7_kj = 0;
+}
+
+static unsigned char
+v7_rc4_byte (void)
+{
+  unsigned char t;
+  v7_ki = (v7_ki + 1) & 0xff;
+  v7_kj = (v7_kj + v7_s[v7_ki]) & 0xff;
+  t = v7_s[v7_ki]; v7_s[v7_ki] = v7_s[v7_kj]; v7_s[v7_kj] = t;
+  return (unsigned char) (v7_s[(v7_s[v7_ki] + v7_s[v7_kj]) & 0xff]);
+}
+
+/* ---------------- SHA-256（FIPS 180-4，自包含） ---------------- */
+static unsigned int
+v7_ror (unsigned int x, int n) { return (x >> n) | (x << (32 - n)); }
+
+typedef struct {
+  unsigned int h[8];
+  unsigned long long total;
+  unsigned char buf[64];
+  size_t fill;
+} V7_SHA256;
+
+static const unsigned int v7_k256[64] = {
+  0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+  0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+  0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+  0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+  0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+  0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+  0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+  0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
+};
+
+static void
+v7_sha256_init (V7_SHA256 *c)
+{
+  c->h[0]=0x6a09e667; c->h[1]=0xbb67ae85; c->h[2]=0x3c6ef372; c->h[3]=0xa54ff53a;
+  c->h[4]=0x510e527f; c->h[5]=0x9b05688c; c->h[6]=0x1f83d9ab; c->h[7]=0x5be0cd19;
+  c->total = 0; c->fill = 0;
+}
+
+static void
+v7_sha256_block (V7_SHA256 *c, const unsigned char *p)
+{
+  unsigned int w[64], a, b, cc, d, e, f, g, h, t1, t2, s0, s1;
+  int i;
+  for (i = 0; i < 16; i++)
+    w[i] = ((unsigned int) p[i*4] << 24) | ((unsigned int) p[i*4+1] << 16) |
+           ((unsigned int) p[i*4+2] << 8) | (unsigned int) p[i*4+3];
+  for (; i < 64; i++)
+    {
+      s0 = v7_ror (w[i-15], 7) ^ v7_ror (w[i-15], 18) ^ (w[i-15] >> 3);
+      s1 = v7_ror (w[i-2], 17) ^ v7_ror (w[i-2], 19) ^ (w[i-2] >> 10);
+      w[i] = w[i-16] + s0 + w[i-7] + s1;
+    }
+  a=c->h[0]; b=c->h[1]; cc=c->h[2]; d=c->h[3];
+  e=c->h[4]; f=c->h[5]; g=c->h[6]; h=c->h[7];
+  for (i = 0; i < 64; i++)
+    {
+      unsigned int S1 = v7_ror (e, 6) ^ v7_ror (e, 11) ^ v7_ror (e, 25);
+      unsigned int ch = (e & f) ^ ((~e) & g);
+      unsigned int S0 = v7_ror (a, 2) ^ v7_ror (a, 13) ^ v7_ror (a, 22);
+      unsigned int mj = (a & b) ^ (a & cc) ^ (b & cc);
+      t1 = h + S1 + ch + v7_k256[i] + w[i];
+      t2 = S0 + mj;
+      h=g; g=f; f=e; e=d+t1; d=cc; cc=b; b=a; a=t1+t2;
+    }
+  c->h[0]+=a; c->h[1]+=b; c->h[2]+=cc; c->h[3]+=d;
+  c->h[4]+=e; c->h[5]+=f; c->h[6]+=g; c->h[7]+=h;
+}
+
+static void
+v7_sha256_update (V7_SHA256 *c, const unsigned char *data, size_t len)
+{
+  c->total += len;
+  while (len > 0)
+    {
+      size_t n;
+      if (c->fill == 0 && len >= 64)
+        { v7_sha256_block (c, data); data += 64; len -= 64; continue; }
+      n = 64 - c->fill;
+      if (n > len) n = len;
+      memcpy (c->buf + c->fill, data, n);
+      c->fill += n; data += n; len -= n;
+      if (c->fill == 64) { v7_sha256_block (c, c->buf); c->fill = 0; }
+    }
+}
+
+static void
+v7_sha256_final (V7_SHA256 *c, unsigned char out[32])
+{
+  unsigned long long bits = c->total * 8;
+  unsigned char pad = 0x80, z = 0, lenb[8];
+  int i;
+  v7_sha256_update (c, &pad, 1);
+  pad = 0;
+  while (c->fill != 56) v7_sha256_update (c, &pad, 1);
+  for (i = 0; i < 8; i++) lenb[i] = (unsigned char) (bits >> (56 - 8 * i));
+  v7_sha256_update (c, lenb, 8);
+  for (i = 0; i < 8; i++)
+    {
+      out[i*4]   = (unsigned char) (c->h[i] >> 24);
+      out[i*4+1] = (unsigned char) (c->h[i] >> 16);
+      out[i*4+2] = (unsigned char) (c->h[i] >> 8);
+      out[i*4+3] = (unsigned char) (c->h[i]);
+    }
+}
+
+/* ---------------- HMAC-SHA256 ---------------- */
+static void
+v7_hmac_sha256 (const unsigned char *key, size_t klen,
+                const unsigned char *msg, size_t mlen,
+                unsigned char out[32])
+{
+  unsigned char k[64], ipad[64], opad[64], inner[32];
+  V7_SHA256 c;
+  int i;
+  memset (k, 0, 64);
+  if (klen > 64)
+    { v7_sha256_init (&c); v7_sha256_update (&c, key, klen); v7_sha256_final (&c, k); }
+  else
+    memcpy (k, key, klen);
+  for (i = 0; i < 64; i++) { ipad[i] = k[i] ^ 0x36; opad[i] = k[i] ^ 0x5c; }
+  v7_sha256_init (&c);
+  v7_sha256_update (&c, ipad, 64);
+  v7_sha256_update (&c, msg, mlen);
+  v7_sha256_final (&c, inner);
+  v7_sha256_init (&c);
+  v7_sha256_update (&c, opad, 64);
+  v7_sha256_update (&c, inner, 32);
+  v7_sha256_final (&c, out);
+  memset (k, 0, 64); memset (ipad, 0, 64); memset (opad, 0, 64);
+}
+
+/* ---------------- KDF：HMAC-SHA256 链（两端必须逐字一致） ----------------
+ * dk0   = HMAC(pass, salt || "v7-kdf")
+ * dk(i) = HMAC(dk(i-1), salt || be32(i))     i = 0 .. ROUNDS-1
+ * key_enc = dk[0:16]，key_mac = dk[16:32]
+ */
+static void
+v7_kdf (const unsigned char *pass, size_t plen,
+        const unsigned char *salt /* 16B */,
+        unsigned char key_enc[16], unsigned char key_mac[16])
+{
+  unsigned char dk[32], out[32], msg[20];
+  static const char dom[6] = { 'v', '7', '-', 'k', 'd', 'f' };
+  unsigned char m0[22];
+  unsigned int ctr;
+  int i;
+  memcpy (m0, salt, 16);
+  memcpy (m0 + 16, dom, 6);
+  v7_hmac_sha256 (pass, plen, m0, 22, dk);
+  for (i = 0; i < V7_KDF_ROUNDS; i++)
+    {
+      ctr = (unsigned int) i;
+      memcpy (msg, salt, 16);
+      msg[16] = (unsigned char) (ctr >> 24);
+      msg[17] = (unsigned char) (ctr >> 16);
+      msg[18] = (unsigned char) (ctr >> 8);
+      msg[19] = (unsigned char) (ctr);
+      v7_hmac_sha256 (dk, 32, msg, 20, out);
+      memcpy (dk, out, 32);
+    }
+  memcpy (key_enc, dk, 16);
+  memcpy (key_mac, dk + 16, 16);
+  memset (dk, 0, 32); memset (out, 0, 32);
+}
+
+static void
+v7_init (void)
+{
+  const char *pass;
+  unsigned char key_enc[16], key_mac[16], calc[32], lenbuf[4];
+  int fd;
+  struct stat st;
+  off_t total, tail_start;
+  size_t taillen, ctlen, got;
+  ssize_t n;
+  unsigned char *tail;
+
+  v7_inited = 1;                 /* 先置位，避免递归 */
+
+  /* 仅 V7_SELF 存在时激活；否则完全走上游逻辑 */
+  if (getenv ("V7_SELF") == NULL)
+    return;
+
+  fd = open ("/proc/self/exe", O_RDONLY);
+  if (fd < 0) { fprintf (stderr, "v7: 无法打开 /proc/self/exe\n"); exit (114); }
+  if (fstat (fd, &st) != 0 || st.st_size < (off_t) (V7_BLOB_OVERHEAD + 4))
+    { close (fd); fprintf (stderr, "v7: 产物未内嵌脚本（尺寸异常）\n"); exit (114); }
+  total = st.st_size;
+  if (pread (fd, lenbuf, 4, total - 4) != 4)
+    { close (fd); fprintf (stderr, "v7: 读取尾部长度失败\n"); exit (114); }
+  taillen = (size_t) lenbuf[0] | ((size_t) lenbuf[1] << 8) |
+            ((size_t) lenbuf[2] << 16) | ((size_t) lenbuf[3] << 24);
+  if (taillen < (size_t) V7_BLOB_OVERHEAD + 1 || (off_t) taillen + 4 > total)
+    { close (fd); fprintf (stderr, "v7: 产物未内嵌脚本（尾部布局无效）\n"); exit (114); }
+  ctlen = taillen - (size_t) V7_BLOB_OVERHEAD;
+  tail_start = total - (off_t) taillen;
+  tail = (unsigned char *) malloc (taillen);
+  if (tail == NULL) { close (fd); fprintf (stderr, "v7: 内存不足\n"); exit (114); }
+  got = 0;
+  while (got < taillen)
+    {
+      n = pread (fd, tail + got, taillen - got, tail_start + (off_t) got);
+      if (n <= 0) break;
+      got += (size_t) n;
+    }
+  close (fd);
+  if (got != taillen) { free (tail); fprintf (stderr, "v7: 读取内嵌密文失败\n"); exit (114); }
+
+  v7_ct = tail;                          /* tail[0 .. ctlen) 即密文 */
+  v7_ct_len = ctlen;
+  v7_off = 0;
+
+  /* 外层口令必填 → KDF → HMAC 认证 */
+  pass = getenv ("V7_PASS");
+  if (pass == NULL || *pass == '\0')
+    { fprintf (stderr, "v7: 缺少 V7_PASS（产物需要外层口令）\n"); exit (114); }
+  v7_kdf ((const unsigned char *) pass, strlen (pass),
+          tail + ctlen + 32 /* salt */, key_enc, key_mac);
+  v7_hmac_sha256 (key_mac, 16, tail, ctlen, calc);
+  if (memcmp (calc, tail + ctlen /* mac */, 32) != 0)
+    {
+      memset (key_enc, 0, 16); memset (key_mac, 0, 16); memset (calc, 0, 32);
+      fprintf (stderr, "v7: 外层口令错误或产物被篡改（HMAC 校验失败）\n");
+      exit (114);
+    }
+  v7_rc4_init (key_enc, 16);
+  memset (key_enc, 0, 16); memset (key_mac, 0, 16); memset (calc, 0, 32);
+  v7_active = 1;
+
+  /* 通知 V6 骨架：脚本来自内存注入，$0 不可信 ——
+   * H_skel / d0 完整性跳过 sed 重读分支，走构建期预计算的内嵌值 */
+  setenv ("V7_EMBED", "1", 1);
+}
+
+/* input.c：判断 fd 是否是 bash 当前脚本输入（脚本读取专用，`read` 内建不走它） */
+extern int fd_is_bash_input (int);
+
+/* 从内嵌密文按序产明文（RC4 对称，解密即加密） */
+static ssize_t
+v7_read (int fd, char *buf, size_t len)
+{
+  size_t avail = v7_ct_len - v7_off;
+  size_t n = (len < avail) ? len : avail;
+  size_t i;
+  (void) fd;
+  if (n == 0) return 0;          /* EOF */
+  for (i = 0; i < n; i++)
+    buf[i] = (char) (v7_ct[v7_off + i] ^ v7_rc4_byte ());
+  v7_off += n;
+  return (ssize_t) n;
+}
+
